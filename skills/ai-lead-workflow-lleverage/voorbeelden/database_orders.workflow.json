    {
      "id": "08db9aab-d837-4a5c-ad9f-c7fa731925c4",
      "nodeId": "Haal_Orders",
      "type": "databaseQuery",
      "inputs": {
        "connection": {
          "type": "auto",
          "value": "{{_secret.POSTGRES_CONNECTION_STRING_DEV_NAAM}}"
        },
        "sshKey": {
          "type": "auto",
          "value": "{{_secret.POSTGRES_SSH_KEY_NAAM}}"
        },
        "sshHost": {
          "type": "auto",
          "value": "{{_env.POSTGRES_SSH_HOST_NAAM}}"
        },
        "sshPort": {
          "type": "auto",
          "value": "{{_env.POSTGRES_SSH_PORT_NAAM}}"
        },
        "sshUser": {
          "type": "auto",
          "value": "{{_env.POSTGRES_SSH_USER_NAAM}}"
        },
        "query": {
          "type": "auto",
          "value": "SELECT salesordernumber AS ordernummer,\n       left(ordercreationdatetime, 10) AS datum,\n       salesordername AS klant,\n       deliverymodecode AS leverwijze,\n       deliveryaddresscity AS plaats\nFROM playground.sales_order_header\nORDER BY ordercreationdatetime DESC\nLIMIT 20"
        }
      },
      "position": {
        "x": 485,
        "y": 45
      },
      "width": 420,
      "description": "Database (schema playground, alleen lezen). Verbinding via secrets, niets inline. Uitvoer lees je alleen in een js-stap: Haal_Orders.result (de rijen).",
      "descriptionManual": true
    },
    {
      "id": "3cf2b720-79b9-4e27-9e53-ef2db15f8e55",
      "nodeId": "Maak_Lijst",
      "type": "javascript",
      "inputs": {
        "script": {
          "type": "literal",
          "value": "// De rijen uit het databaseblok (een lege lijst als er niets kwam).\nvar rijen = Haal_Orders.result || [];\n// Eén regel tekst per order.\nvar regels = rijen.map(function (r) {\n  return r.datum + ' ' + r.ordernummer + ' ' + r.klant + ' (' + r.leverwijze + ', ' + r.plaats + ')';\n});\n// <br> is een nieuwe regel in de mail.\nreturn { aantal: rijen.length, tekst: regels.join('<br>') };\n"
        }
      },
      "position": {
        "x": 925,
        "y": 45
      },
      "width": 320,
      "description": "Code. Uitvoer onder {{Maak_Lijst.result.<veld>}}",
      "descriptionManual": true
    },
    {
