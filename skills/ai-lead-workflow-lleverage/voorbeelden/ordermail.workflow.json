                      "type": "text",
                      "text": "Haal uit deze mail de bestelling. Neem de leverdatum letterlijk over.\n\nONDERWERP: {{Mailbox.data.subject}}\nMAIL:\n---\n{{Mailbox.data.body}}\n---"
                    }
                  ]
                }
              ]
            }
          }
        },
        "_jsonFormat": {
          "type": "literal",
          "value": true
