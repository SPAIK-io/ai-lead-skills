            "additionalProperties": false,
            "properties": {
              "klant": {
                "type": "string"
              },
              "leverdatum_letterlijk": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "regels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "is_order": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "position": {
        "x": 485,
        "y": 45
      },
      "width": 320,
      "description": "LLM. Uitvoer onder {{Lees_Mail.output.<veld>}}: klant, leverdatum_letterlijk, regels, is_order",
      "descriptionManual": true
    },
    {
      "id": "n-check",
      "nodeId": "Check",
      "type": "javascript",
      "inputs": {
        "script": {
          "type": "literal",
          "value": "const o = Lees_Mail.output; return {ok: o.is_order === true && o.regels.length > 0, aantal: o.regels.length};"
        }
      },
      "position": {
        "x": 925,
        "y": 45
      },
      "width": 320,
      "description": "Code. Uitvoer onder {{Check.result.<veld>}}",
      "descriptionManual": true
    },
    {
      "id": "n-splits",
